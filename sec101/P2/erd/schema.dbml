Table users {
  id          integer     [pk, increment]
  name        varchar(100) [not null]
  email       varchar(255) [not null, unique]
  password    varchar(255) [not null]
  description text        [default: '']
  created_at  timestamp   [default: `now()`]
  updated_at  timestamp   [default: `now()`]
}

Table user_roles {
  id      integer     [pk, increment]
  user_id integer     [not null, ref: > users.id]
  role    varchar(20) [not null, note: 'STUDENT | INSTRUCTOR | ADMIN']

  indexes {
    (user_id, role) [unique]
  }
}

Table categories {
  id         integer      [pk, increment]
  name       varchar(100) [not null]
  created_at timestamp    [default: `now()`]
}

Table courses {
  id             integer      [pk, increment]
  instructor_id  integer      [not null, ref: > users.id]
  category_id    integer      [not null, ref: > categories.id]
  title          varchar(255) [not null]
  description    text         [not null]
  thumbnail      varchar(500)
  difficulty     varchar(20)  [not null, note: 'EASY | MEDIUM | HARD']
  slug           varchar(255) [not null, unique]
  price          integer      [not null]
  rating         float        [default: 0]
  max_capacity   integer      [default: 30]
  min_enrollment integer      [default: 1]
  status         varchar(20)  [default: 'OPEN', note: 'OPEN | CANCELED']
  canceled_at    timestamp
  cancel_reason  varchar(50)
  created_at     timestamp    [default: `now()`]
  updated_at     timestamp    [default: `now()`]
}

Table chapter {
  id        integer      [pk, increment]
  course_id integer      [not null, ref: > courses.id]
  title     varchar(255) [not null]
  position  integer      [not null]

  indexes {
    (course_id, position) [unique]
  }
}

Table lectures {
  id            integer      [pk, increment]
  chapter_id    integer      [not null, ref: > chapter.id]
  title         varchar(255) [not null]
  video_url     varchar(500) [not null]
  thumbnail_url varchar(500)
  duration      integer      [not null, note: '초 단위']
  position      integer      [not null]
  is_published  boolean      [default: false]
  created_at    timestamp    [default: `now()`]

  indexes {
    (chapter_id, position) [unique]
  }
}

Table cart_items {
  id             integer     [pk, increment]
  user_id        integer     [not null, ref: > users.id]
  course_id      integer     [not null, ref: > courses.id]
  status         varchar(20) [default: 'ACTIVE', note: 'ACTIVE | CHECKED_OUT | REMOVED']
  added_at       timestamp   [default: `now()`]
  updated_at     timestamp   [default: `now()`]
  checked_out_at timestamp
}

Table orders {
  id                integer      [pk, increment]
  user_id           integer      [not null, ref: > users.id]
  order_number      varchar(100) [not null, unique]
  provider          varchar(20)  [default: 'TOSS', note: 'TOSS | DEMO']
  provider_order_id varchar(255)
  status            varchar(30)  [default: 'PENDING', note: 'PENDING | PAID | PARTIALLY_REFUNDED | REFUNDED | CANCELED']
  total_amount      integer      [not null]
  paid_amount       integer      [default: 0]
  refunded_amount   integer      [default: 0]
  created_at        timestamp    [default: `now()`]
  paid_at           timestamp
  canceled_at       timestamp
  updated_at        timestamp    [default: `now()`]
}

Table order_items {
  id                  integer     [pk, increment]
  order_id            integer     [not null, ref: > orders.id]
  user_id             integer     [not null, ref: > users.id]
  course_id           integer     [not null, ref: > courses.id]
  price               integer     [not null]
  status              varchar(20) [default: 'PENDING', note: 'PENDING | ENROLLED | CANCELED | REFUNDED']
  enrolled_at         timestamp
  canceled_at         timestamp
  refund_amount       integer     [default: 0]
  cancellation_reason varchar(50)
  created_at          timestamp   [default: `now()`]
  updated_at          timestamp   [default: `now()`]
}

Table payment_transactions {
  id               integer     [pk, increment]
  order_id         integer     [not null, ref: > orders.id]
  user_id          integer     [not null, ref: > users.id]
  provider         varchar(20) [default: 'TOSS']
  transaction_type varchar(20) [not null, note: 'PAYMENT | REFUND | CANCEL']
  status           varchar(20) [default: 'COMPLETED', note: 'COMPLETED | FAILED | CANCELED']
  amount           integer     [not null]
  payment_key      varchar(255)
  transaction_key  varchar(255)
  reason           text
  metadata         jsonb
  created_at       timestamp   [default: `now()`]
  approved_at      timestamp
  canceled_at      timestamp
}

Table enrollments {
  id                  integer     [pk, increment]
  user_id             integer     [not null, ref: > users.id]
  course_id           integer     [not null, ref: > courses.id]
  order_item_id       integer     [unique, ref: - order_items.id]
  status              varchar(20) [default: 'ACTIVE', note: 'ACTIVE | CANCELED | REFUNDED']
  is_canceled         boolean     [default: false]
  enrolled_at         timestamp   [default: `now()`]
  canceled_at         timestamp
  cancellation_reason varchar(50)
}

Table enrollment_history {
  id            integer     [pk, increment]
  enrollment_id integer     [not null, ref: > enrollments.id]
  user_id       integer     [not null, ref: > users.id]
  course_id     integer     [not null, ref: > courses.id]
  event_type    varchar(20) [not null, note: 'ENROLLED | CANCELED | REFUNDED']
  reason        text
  created_at    timestamp   [default: `now()`]
}

Table course_comment {
  id         integer      [pk, increment]
  user_id    integer      [not null, ref: > users.id]
  course_id  integer      [not null, ref: > courses.id]
  parent_id  integer      [ref: > course_comment.id]
  title      varchar(255)
  content    text         [not null]
  star       integer      [default: 0, note: '0이면 평점 없음(대댓글)']
  created_at timestamp    [default: `now()`]
  updated_at timestamp    [default: `now()`]
}

Table lecture_comment {
  id         integer      [pk, increment]
  user_id    integer      [not null, ref: > users.id]
  lecture_id integer      [not null, ref: > lectures.id]
  parent_id  integer      [ref: > lecture_comment.id]
  title      varchar(255)
  content    text         [not null]
  star       integer      [default: 0]
  created_at timestamp    [default: `now()`]
}

Table lectures_progress {
  id              integer   [pk, increment]
  user_id         integer   [not null, ref: > users.id]
  lecture_id      integer   [not null, ref: > lectures.id]
  last_position   integer   [default: 0, note: '마지막 재생 위치(초)']
  watched_seconds integer   [default: 0, note: '실제 시청 시간(초)']
  progress        integer   [default: 0, note: '진도율 0~100']
  is_completed    boolean   [default: false]
  updated_at      timestamp [default: `now()`]

  indexes {
    (user_id, lecture_id) [unique]
  }
}

Table lecture_playback_history {
  id          integer     [pk, increment]
  user_id     integer     [not null, ref: > users.id]
  lecture_id  integer     [not null, ref: > lectures.id]
  event_type  varchar(20) [not null, note: 'STARTED | PROGRESS | RESUMED | COMPLETED']
  from_second integer     [default: 0]
  to_second   integer     [default: 0]
  progress    integer     [default: 0]
  created_at  timestamp   [default: `now()`]
}

Table lecture_bookmark {
  id         integer   [pk, increment]
  user_id    integer   [not null, ref: > users.id]
  lecture_id integer   [not null, ref: > lectures.id]
  note       text
  position   integer   [not null, note: '북마크 위치(초)']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table instructor_rating {
  id            integer   [pk, increment]
  instructor_id integer   [not null, ref: > users.id]
  user_id       integer   [not null, ref: > users.id]
  star          integer   [not null, note: '1~5']
  content       text
  created_at    timestamp [default: `now()`]

  indexes {
    (instructor_id, user_id) [unique]
  }
}

Table course_report {
  id          integer     [pk, increment]
  course_id   integer     [not null, ref: > courses.id]
  user_id     integer     [not null, ref: > users.id]
  type        varchar(20) [not null, note: 'COPYRIGHT | WRONG_INFO | OTHER']
  content     text        [not null]
  is_resolved boolean     [default: false]
  created_at  timestamp   [default: `now()`]
}

Table lecture_materials {
  id         integer      [pk, increment]
  lecture_id integer      [not null, ref: > lectures.id]
  title      varchar(255) [not null]
  file_url   varchar(500) [not null]
  file_name  varchar(255) [not null]
  file_size  integer
  file_type  varchar(50)
  position   integer      [default: 0]
  created_at timestamp    [default: `now()`]
}
