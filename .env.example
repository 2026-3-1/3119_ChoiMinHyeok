# ── DB ─────────────────────────────────────────────────────────
DB_PASSWORD=your-strong-db-password-here

# ── JWT (각각 32바이트 이상 랜덤 문자열) ───────────────────────
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-hex-string-32-bytes-min
JWT_REFRESH_SECRET=replace-with-another-random-hex-string-32-bytes-min

# ── CORS ────────────────────────────────────────────────────────
# EC2 퍼블릭 IP 또는 도메인 (포트 없이)
CLIENT_ORIGIN=http://your-ec2-ip-or-domain
