generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model lectures {
  id                Int @id @default(autoincrement())
  chapter_id        Int
  title             String
  video_url         String
  thumbnail_url     String
  duration          Int
  position          Int
  is_published      Boolean  @default(false)
  created_at        DateTime @default(now())

  chapters          chapter @relation(fields: [chapter_id], references: [id])

  @@unique([chapter_id, position])
}

model chapter {
  id            Int @id @default(autoincrement())
  course_id     Int
  title         String
  position      Int

  courses       courses @relation(fields: [course_id], references: [id])

  lectures      lectures[]

  @@unique([course_id, position])
}

model courses {
  id            Int @id @default(autoincrement())
  title         String
  description   String
  instructor_id Int
  thumbnail     String
  difficulty    Difficulty
  category_id   Int
  slug          String @unique
  created_at    DateTime @default(now())
  updated_at    DateTime

  category      categories @relation(fields: [category_id], references: [id])

  chapters      chapter[]
}

model categories {
  id            Int @id @default(autoincrement())
  name          String
  created_at    DateTime @default(now())

  courses       courses[]
}

model course_comment {
  id            Int @id @default(autoincrement())
  title         String
  content       String
  user_id       Int
  course_id     Int
  create_at     DateTime @default(now())
}

model lecture_comment {
  id            Int @id @default(autoincrement())
  title         String
  content       String
  user_id       Int
  lecture_id     Int
  create_at     DateTime @default(now())
}

